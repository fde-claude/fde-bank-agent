# Copy to .env and fill in. NEVER commit .env — it is in .gitignore. [OPS]
# In Kubernetes these two values arrive as a Secret (the key) and a ConfigMap (the model).

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Pinned model ID. Change it here, not in code. Fallback (claude-opus-5-5) is wired at the gateway in Module 4.
MODEL_ID=claude-haiku-5-5
