# Copy to .env and fill in. NEVER commit .env — it is in .gitignore. [OPS]
# Compose hands each service only the variables it needs (see docker-compose.yml).
# In Kubernetes these arrive as Secrets (keys, passwords) and ConfigMaps (everything else).

# --- agent ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Pinned model ID. Change it here, not in code. From Step 10 the app calls the gateway alias "bank-primary" instead.
MODEL_ID=claude-haiku-5-5

# --- LiteLLM gateway (Step 9) ---  generate each secret with:  openssl rand -hex 32
LITELLM_MASTER_KEY=sk-REPLACE_ME        # admin credential for the gateway API and UI; the proxy refuses weak values
LITELLM_SALT_KEY=sk-REPLACE_ME          # encrypts credentials stored in the DB; set once and never rotate
UI_USERNAME=admin
UI_PASSWORD=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME

# --- agent -> gateway (Step 10) ---  the virtual key created in the admin UI (Step 9 lab, Task 2)
LITELLM_VIRTUAL_KEY=sk-REPLACE_ME

# --- knowledge base (Step 13) ---
KNOWLEDGE_DB_PASSWORD=REPLACE_ME

# --- observability (Step 15) ---  Langfuse Cloud project keys (Settings -> API Keys); EU region host shown, US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_HOST=https://cloud.langfuse.com
